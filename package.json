{
  "name": "@dmsdc-ai/telesession",
  "version": "0.1.0",
  "private": true,
  "description": "Session-level prompt exchange over a local telepty daemon: exact targets, owned inbox, audit-verified replies, MCP adapter.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.js",
    "./mcp": "./src/adapters/mcp.js"
  },
  "bin": {
    "telesession-mcp": "bin/telesession-mcp.js",
    "telesession-tunnel-child": "bin/telesession-tunnel-child.js",
    "telesession-relay-tick": "bin/telesession-relay-tick.js",
    "telesession-ledger-prune": "bin/telesession-ledger-prune.js"
  },
  "scripts": {
    "test": "node --test test/",
    "test:unit": "node --test --test-reporter=tap test/config.test.js test/store.test.js test/tunnel-child.test.js test/tunnel-child-independent.test.js",
    "check:pack": "npm pack --dry-run --ignore-scripts"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.24.0"
  },
  "license": "MIT"
}
